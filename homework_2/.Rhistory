#| label: setup
#| include: false
options(styler.save_after_styling = TRUE)
library(tidyverse)
energy_types <- read_csv("https://raw.githubusercontent.com/rfordatascience/tidytuesday/master/data/2020/2020-08-04/energy_types.csv")
country_totals <- read_csv("https://raw.githubusercontent.com/rfordatascience/tidytuesday/master/data/2020/2020-08-04/country_totals.csv")
energy_types <- energy_types |>
filter(level == "Level 1") |>
mutate(country_name = ifelse(is.na(country_name), "UK", country_name))
head(energy_types)
energy_types
#pivot longer(cols=)
energy_types_longer <- energy_types |>
pivot_longer(cols= c("2016","2017","2018"), names_to = "year", values_to = "gigawatts")
energy_types_longer
#install.packages("cowplot")
#install.packages("scales")
library(scales)
library(cowplot)
energy_types_longer |>
ggplot(aes(year, gigawatts, group = country)) + #setting the plot x,y,group
geom_line(color = "steelblue", linewidth = 0.8) + #line attributes, line_width doesn't work
geom_point(shape = 21, fill = "steelblue", size = 2) + #point attributes
facet_wrap(~type, scales = "free_y") + #freeing y axis with scales =
scale_y_continuous(labels = scales::comma) +
theme_minimal_hgrid()
wind_2018 <- energy_types_longer |>
filter(type == "Wind", year == 2018) |> #containing requires filtering through columns
arrange(gigawatts) |> #arranged
mutate(country_name = fct_inorder(country_name))
head(wind_2018) #crosschecking on what the tibble looks like
ggplot(wind_2018, aes(x = gigawatts, y = country_name)) + #putting the aes in ggplot
geom_col( fill = "steelblue", alpha = 0.9) + #visual set up to col
scale_x_continuous(labels = scales::comma) + #Set the x-axis to use commas in their labels
labs(y = NULL) + #removing the y title with labs
theme_minimal_vgrid()
knitr::include_graphics("https://i.imgur.com/eShlIRa.jpg")
#install.packages("ggtext")
library(ggtext)
wind_2018 |>
mutate(
germany = country_name == "Germany",
country_name = fct_recode(country_name, "<span style='color:firebrick'>Germany</i>" = "Germany")
) |>
ggplot(aes(x = gigawatts, y = country_name)) +
geom_col(aes(fill = germany), alpha = .9, show.legend = FALSE) +
scale_fill_manual(values = c("steelblue", "firebrick")) +
scale_x_continuous(labels = scales::comma) +
ylab(NULL) +
theme_minimal_vgrid() +
theme(axis.text.y = element_markdown())
knitr::include_graphics("https://i.imgur.com/hENxTXG.jpg")
install.packages("tidyverse")
install.packages("readxl") #to read excel
install.packages("janitor") #for any additional functions
quarto::quarto_install_tinytex()
if (!requireNamespace("tinytex", quietly = TRUE)) install.packages("tinytex")
tinytex::install_tinytex()
knitr::opts_chunk$set(echo = TRUE)
# Load data
cm <- read.table("CH01PR20.txt", header=F)
colnames(cm) <- c("time", "copiers")
head(cm, 3)
tail(cm, 2)
summary(cm)
cm.SLR <- lm(time ~ copiers, data = cm)
cm.SLR <- lm(time ~ copiers, data = cm)
cm.SLR
plot(time~copiers, data= cm)
cm.SLR <- lm(time ~ copiers, data = cm)
cm.SLR
#estimation equation would be time^ (time hat)= -0.5802 + 0.0001*copiers
cm.SLR <- lm(copiers ~ time, data = cm)
cm.SLR
#estimation equation would be time^ (time hat)= -0.5802 + 0.0001*copiers
cm.SLR <- lm(time ~ copiers, data = cm)
cm.SLR
#estimation equation would be time^ (time hat)= -0.5802 + 0.0001*copiers
